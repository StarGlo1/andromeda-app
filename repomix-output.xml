<file path="app/page.tsx">
import { prisma } from "@/lib/prisma";
import Navbar from "./components/Navbar";
import DashboardWidgets from "./components/DashboardWidgets";

export default async function DashboardPage() {
  const [rawMaterialsCount, finishedGoodsCount, activeRecipesCount, salesData] = await Promise.all([
    prisma.rawMaterial.count(),
    prisma.finishedGood.count(),
    prisma.finishedGood.count({ where: { recipeItems: { some: { id: { not: "" } } } } }),
    prisma.sale.aggregate({
      _sum: { totalAmount: true },
      _count: true,
    }),
  ]);

  const allMaterials = await prisma.rawMaterial.findMany({
    orderBy: { updatedAt: "desc" },
    include: { category: true },
  });

  const lowStockMaterials = allMaterials.filter(
    (m) => m.reorderThreshold !== null && (m.totalQuantity ?? 0) <= m.reorderThreshold!
  );

  const totalInventoryValue = allMaterials.reduce(
    (sum, m) => sum + (m.totalQuantity ?? 0) * (m.costPerUnit ?? 0),
    0
  );

  const allGoods = await prisma.finishedGood.findMany();
  const totalProducts = allGoods.length;
  const avgCogs = allGoods.length > 0
    ? allGoods.reduce((sum, g) => sum + (g.calculatedCogs ?? 0), 0) / allGoods.length
    : 0;

  const potentialProfit = allGoods.reduce(
    (sum, g) => sum + (g.retailPrice - (g.calculatedCogs ?? 0)) * g.quantityOnHand,
    0
  );

  const recentMaterials = await prisma.rawMaterial.findMany({
    take: 3,
    orderBy: { updatedAt: "desc" },
    select: { id: true, name: true, updatedAt: true },
  });
  const recentGoods = await prisma.finishedGood.findMany({
    take: 2,
    orderBy: { updatedAt: "desc" },
    select: { id: true, name: true, updatedAt: true },
  });

  const recentActivity = [
    ...recentMaterials.map((m) => ({
      type: "material" as const,
      name: m.name,
      when: m.updatedAt,
      link: "/materials",
    })),
    ...recentGoods.map((g) => ({
      type: "product" as const,
      name: g.name,
      when: g.updatedAt,
      link: "/finished-goods",
    })),
  ].sort((a, b) => (b.when > a.when ? 1 : -1))
   .slice(0, 5);

  const dashboardData = {
    rawMaterialsCount,
    lowStockCount: lowStockMaterials.length,
    totalProducts,
    totalInventoryValue,
    activeRecipesCount,
    avgCogs,
    potentialProfit,
    lowStockMaterials,
    recentActivity,
    totalSales: salesData._count,
    totalRevenue: salesData._sum?.totalAmount ?? 0,
  };

  return (
    <main className="min-h-screen bg-bg text-text p-4 sm:p-8">
      <div className="max-w-6xl mx-auto space-y-8">
        <Navbar />
        <div className="overflow-x-auto">
          <DashboardWidgets data={dashboardData} />
        </div>
      </div>
    </main>
  );
}
