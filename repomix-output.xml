            </div>
          </section>

          {/* Preferences */}
          <section className="bg-surface-widget border border-default rounded-xl p-6">
            <h2 className="text-lg font-semibold text-text mb-4">Preferences</h2>
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
