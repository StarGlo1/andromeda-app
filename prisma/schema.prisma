// prisma/schema.prisma

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id           String        @id @default(uuid())
  name         String        @unique
  rawMaterials RawMaterial[]

  @@map("categories")
}

model Supplier {
  id             String          @id @default(uuid())
  name           String
  contact        String?
  website        String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  rawMaterials   RawMaterial[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model RawMaterial {
  id                 String              @id @default(uuid())
  name               String
  categoryId         String
  category           Category            @relation(fields: [categoryId], references: [id])
  supplierId         String?
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  totalQuantity      Float?
  quantity           Float?
  sizePerUnit        Float?
  unit               String?
  costPerUnit        Float?
  reorderThreshold   Float?
  committedQuantity  Float?              @default(0)
  onOrderQuantity    Float?              @default(0)
  imagePath          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  recipeItems        RecipeItem[]
  adjustments        Adjustment[]
  purchaseOrderItems PurchaseOrderItem[]
  lots               Lot[]

  @@map("raw_materials")
}

model FinishedGood {
  id                   String       @id @default(uuid())
  name                 String
  sku                  String?      @unique
  batchCode            String
  quantityOnHand       Int          @default(0)
  retailPrice          Float
  calculatedCogs       Float        @default(0.0)
  vesselSizeOz         Float?
  fragranceLoadPercent Float?
  laborCostPerUnit     Float?       @default(0)
  overheadFlat         Float?       @default(0)
  overheadPercent      Float?       @default(0)
  isCoreElement        Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  recipeItems       RecipeItem[] @relation("RecipeParent")
  usedAsSubAssembly RecipeItem[] @relation("SubAssemblyRecipe")
  saleItems         SaleItem[]
  lots              Lot[]
  consignmentItems  ConsignmentBatchItem[]

  @@map("finished_goods")
}

model RecipeItem {
  id               String        @id @default(uuid())
  finishedGoodId   String
  rawMaterialId    String?
  subAssemblyId    String?
  requiredQuantity Float
  unit             String

  finishedGood FinishedGood  @relation("RecipeParent", fields: [finishedGoodId], references: [id], onDelete: Cascade)
  rawMaterial  RawMaterial?  @relation(fields: [rawMaterialId], references: [id])
  subAssembly  FinishedGood? @relation("SubAssemblyRecipe", fields: [subAssemblyId], references: [id])

  @@unique([finishedGoodId, rawMaterialId])
  @@map("recipe_items")
}

model Adjustment {
  id         String      @id @default(uuid())
  materialId String
  material   RawMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quantity   Float
  reason     String
  notes      String?
  createdAt  DateTime    @default(now())

  @@map("adjustments")
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  receivedDate DateTime?
  status       String              @default("Pending")
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  items        PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  materialId      String
  material        RawMaterial   @relation(fields: [materialId], references: [id])
  quantity        Float
  unitCost        Float
  receivedQty     Float         @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("purchase_order_items")
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]

  @@map("customers")
}

model Sale {
  id          String     @id @default(uuid())
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id])
  saleDate    DateTime   @default(now())
  totalAmount Float
  discount    Float      @default(0)
  tax         Float      @default(0)
  status      String     @default("Paid")
  notes       String?
  eventId     String?
  event       Event?     @relation(fields: [eventId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       SaleItem[]

  @@map("sales")
}

model SaleItem {
  id             String       @id @default(uuid())
  saleId         String
  sale           Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  finishedGoodId String
  finishedGood   FinishedGood @relation(fields: [finishedGoodId], references: [id])
  quantity       Int
  unitPrice      Float
  totalPrice     Float
  createdAt      DateTime     @default(now())

  @@map("sale_items")
}

model Alert {
  id            String   @id @default(uuid())
  type          String
  title         String
  description   String?
  severity      String   @default("warning")
  status        String   @default("active")
  referenceId   String?
  referenceType String?
  location      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("alerts")
}

model Lot {
  id             String   @id @default(uuid())
  lotNumber      String   @unique
  kind           String
  quantity       Float?
  rawMaterialId  String?
  finishedGoodId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rawMaterial   RawMaterial?  @relation(fields: [rawMaterialId], references: [id], onDelete: SetNull)
  finishedGood  FinishedGood? @relation(fields: [finishedGoodId], references: [id], onDelete: SetNull)

  rawMaterialLinks  LotRawMaterial[] @relation("finishedLot")
  finishedGoodLinks LotRawMaterial[] @relation("rawLot")

  @@map("lots")
}

model LotRawMaterial {
  id                String   @id @default(uuid())
  finishedGoodLotId String
  rawMaterialLotId  String
  quantityUsed      Float
  createdAt         DateTime @default(now())

  finishedGoodLot Lot @relation("finishedLot", fields: [finishedGoodLotId], references: [id], onDelete: Cascade)
  rawMaterialLot  Lot @relation("rawLot", fields: [rawMaterialLotId], references: [id], onDelete: Cascade)

  @@unique([finishedGoodLotId, rawMaterialLotId])
  @@map("lot_raw_materials")
}

model ConsignmentLocation {
  id          String              @id @default(uuid())
  name        String
  type        String              @default("storefront")
  address     String?
  contactName String?
  phone       String?
  email       String?
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  batches     ConsignmentBatch[]

  @@map("consignment_locations")
}

model ConsignmentBatch {
  id                 String                @id @default(uuid())
  locationId         String
  location           ConsignmentLocation   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  datePlaced         DateTime              @default(now())
  expectedReturnDate DateTime?
  returnedDate       DateTime?
  status             String                @default("active")
  notes              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  items              ConsignmentBatchItem[]

  @@map("consignment_batches")
}

model ConsignmentBatchItem {
  id             String           @id @default(uuid())
  batchId        String
  batch          ConsignmentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  finishedGoodId String
  finishedGood   FinishedGood     @relation(fields: [finishedGoodId], references: [id])
  quantity       Int
  unitPrice      Float            @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([batchId, finishedGoodId])
  @@map("consignment_batch_items")
}

model Event {
  id        String   @id @default(uuid())
  name      String
  date      DateTime @default(now())
  location  String?
  type      String   @default("popup")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]

  @@map("events")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}